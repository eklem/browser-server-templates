{
  "name": "browser-server-templates",
  "version": "0.1.0",
  "description": "JavaScript service worker as a server for your webpage, living in your browser.",
  "keywords": [
    "JavaScript",
    "browser",
    "server",
    "development"
  ],
  "homepage": "https://github.com/eklem/worker-server#readme",
  "bugs": {
    "url": "https://github.com/eklem/worker-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eklem/worker-server.git"
  },
  "license": "MIT",
  "author": "Espen Klem",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run build-calculator && npm run build-search-engine",
    "build-calculator": "cp ./node_modules/idb-keyval/dist/index.js ./examples/01-calculator/idb-keyval.js",
    "build-search-engine": "cp ./node_modules/cities.json/cities.json ./examples/02-search-engine/cities.json && cp ./node_modules/idb-keyval/dist/index.js ./examples/02-search-engine/idb-keyval.js && cp ./node_modules/search-index/dist/search-index-esm-*.js ./examples/02-search-engine/search-index.js"
  },
  "dependencies": {
    "cities.json": "^1.1.61",
    "idb-keyval": "^6.3.0",
    "search-index": "^6.0.2"
  }
}
